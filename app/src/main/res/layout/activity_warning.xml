<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:gravity="center">

    <!-- Card Melayang di Tengah -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="@drawable/bg_warning_gradient"
        android:padding="24dp">

        <!-- Warning Icon -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_dialog_alert"
                app:tint="#FFFFFF"
                android:contentDescription="Warning" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/warning_title"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Subtitle / Reason -->
        <TextView
            android:id="@+id/tvWarningReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/warning_subtitle"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:alpha="0.95"
            android:gravity="center" />

        <!-- Blocked URL -->
        <TextView
            android:id="@+id/tvWarningUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#33000000"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:alpha="0.85"
            android:fontFamily="monospace"
            android:gravity="center"
            android:maxLines="3"
            android:ellipsize="middle" />

        <!-- HITL Decision Buttons / Message -->
        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Menurut Anda, apakah ini penipuan?"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Button Aman -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkSafe"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Aman"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:backgroundTint="#4CAF50"
                app:cornerRadius="16dp" />

            <!-- Button Blokir -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseWarning"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Ya, Blokir"
                android:textAllCaps="false"
                android:textColor="#D32F2F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#FFFFFF"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
